# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
WEB_PORT=5173
VITE_API_URL=http://localhost:3000/api
WORKER_CONCURRENCY=2

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=aivideo
POSTGRES_PASSWORD=aivideo
POSTGRES_DB=aivideo
POSTGRES_PORT=5433
DATABASE_URL=postgresql://aivideo:aivideo@localhost:5433/aivideo?schema=public

# =============================================================================
# Redis / BullMQ
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# MinIO (S3-compatible object storage)
# =============================================================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-video
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# FFmpeg / Phase 8 video rendering
# =============================================================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Keep low — rendering is CPU/memory intensive
VIDEO_RENDER_MAX_CONCURRENCY=1
VIDEO_RENDER_MAX_OUTPUT_BYTES=524288000
VIDEO_RENDER_JOB_TIMEOUT_MS=900000

# =============================================================================
# AI Providers — Gemini (Phase 4 story intelligence)
# =============================================================================
# Leave empty + GEMINI_USE_MOCK=true for local/dev without billed API calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=3
GEMINI_USE_MOCK=false
# Configurable USD pricing used only for estimated cost tracking (per 1M tokens).
GEMINI_PRICE_INPUT_PER_MILLION_USD=0.10
GEMINI_PRICE_OUTPUT_PER_MILLION_USD=0.40

# =============================================================================
# AI Providers — Gemini TTS (Phase 7 narration / voice)
# Docs: https://aistudio.google.com/docs/speech-generation
# Pricing: https://aistudio.google.com/docs/pricing (estimates only; not live invoices)
# Default model: gemini-3.8-flash-lite-tts (cost-efficient). Unary output: audio/wav 24kHz mono.
# =============================================================================
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_DEFAULT_VOICE=Kore
GEMINI_TTS_USE_MOCK=true
GEMINI_TTS_TIMEOUT_MS=120000
GEMINI_TTS_MAX_RETRIES=3
GEMINI_TTS_MAX_CONCURRENCY=2
GEMINI_TTS_MAX_CHARACTERS=8000
GEMINI_TTS_MAX_AUDIO_DURATION_SECONDS=600
GEMINI_TTS_MAX_ATTEMPTS_PER_SCENE=20
# Official paid-tier estimates through 2026-12-31 for Flash-Lite TTS.
GEMINI_TTS_PRICE_INPUT_PER_MILLION_USD=0.50
GEMINI_TTS_PRICE_AUDIO_OUTPUT_PER_MILLION_USD=6.00
GEMINI_TTS_AUDIO_TOKENS_PER_SECOND=25
GEMINI_TTS_CURRENCY=USD
# Optional monthly estimated-spend guard (USD). Leave empty to disable.
GEMINI_TTS_MAX_MONTHLY_SPEND_USD=

FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_IMAGE_PRICE_PER_IMAGE=0.025
FAL_IMAGE_DEFAULT_ASPECT_RATIO=9:16
FAL_IMAGE_DEFAULT_FORMAT=png
FAL_IMAGE_TIMEOUT_MS=120000
FAL_IMAGE_MAX_RETRIES=3
FAL_USE_MOCK=true
FAL_IMAGE_SUPPORTS_REFERENCE=false
FAL_IMAGE_CURRENCY=USD

# =============================================================================
# AI Providers — Video generation (Phase 6.1)
# Default: MiniMax Hailuo-02 Standard via fal.ai (reuses FAL_API_KEY)
# Kling remains registered but disabled until KLING_ENABLED=true
# =============================================================================
VIDEO_GENERATION_PROVIDER=hailuo

HAILUO_ENABLED=true
HAILUO_MODEL=fal-ai/minimax/hailuo-02/standard/image-to-video
HAILUO_DEFAULT_RESOLUTION=768P
HAILUO_DEFAULT_DURATION=6
HAILUO_PROMPT_OPTIMIZER=true
HAILUO_MAX_RETRIES=2
HAILUO_TIMEOUT_MS=600000
HAILUO_USE_MOCK=true
HAILUO_MOCK_READY_AFTER_MS=1500
HAILUO_POLL_INTERVAL_SECONDS=15
HAILUO_MAX_POLL_ATTEMPTS=80
HAILUO_PRICE_PER_SECOND_768P_USD=0.045
HAILUO_PRICE_PER_SECOND_512P_USD=0.017
HAILUO_CURRENCY=USD
# Optional monthly estimated-spend guard (USD). Leave empty to disable.
HAILUO_MAX_MONTHLY_SPEND_USD=

# =============================================================================
# AI Providers — Kling (Phase 6 image-to-video, optional / future use)
# Official API: Bearer API key auth against api-singapore.klingai.com
# Docs: https://kling.ai/document-api/api/video/2-6/image-to-video
# =============================================================================
KLING_ENABLED=false
KLING_API_KEY=
# Legacy AK/SK names kept for compatibility; prefer KLING_API_KEY (Bearer).
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_SECRET=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-2.6
KLING_DEFAULT_DURATION_SECONDS=5
KLING_DEFAULT_RESOLUTION=720p
KLING_TIMEOUT_MS=120000
KLING_MAX_RETRIES=3
KLING_POLL_INTERVAL_SECONDS=8
KLING_MAX_POLL_ATTEMPTS=90
KLING_MAX_CONCURRENCY=2
KLING_PRICE_PER_SECOND_USD=0.07
KLING_CURRENCY=USD
# Only affects Kling. When VIDEO_GENERATION_PROVIDER=hailuo, leave this false —
# a true value used to incorrectly force Hailuo into tiny placeholder clips.
KLING_USE_MOCK=false
KLING_MOCK_READY_AFTER_MS=1500
KLING_MAX_CLIPS_PER_SCENE=10
KLING_MAX_ATTEMPTS_PER_SCENE=20
# Optional monthly estimated-spend guard (USD). Leave empty to disable.
KLING_MAX_MONTHLY_SPEND_USD=

# =============================================================================
# Social platforms (OAuth + publishing)
# =============================================================================
PUBLIC_API_URL=http://localhost:3000
SOCIAL_FRONTEND_REDIRECT_URL=http://localhost:5173
SOCIAL_OAUTH_STATE_TTL_SECONDS=600
SOCIAL_USE_MOCK=false
SOCIAL_PUBLIC_MEDIA_BASE_URL=
SOCIAL_PRESIGN_TTL_SECONDS=3600

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/channels/facebook/callback
FACEBOOK_GRAPH_VERSION=v22.0
FACEBOOK_USE_MOCK=false
# Browserless Meta publishing (permanent Page token — no interactive login at publish time)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/channels/instagram/callback
INSTAGRAM_USE_MOCK=false
# Instagram Business/Creator account ID linked to FACEBOOK_PAGE_ID (S2S path)
INSTAGRAM_ACCOUNT_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/channels/tiktok/callback
TIKTOK_USE_MOCK=false
TIKTOK_AUDITED=false

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/channels/youtube/callback
YOUTUBE_USE_MOCK=false
# Optional: after one offline OAuth, store refresh token for browserless uploads
YOUTUBE_REFRESH_TOKEN=

# =============================================================================
# Cookie settings (refresh token)
# =============================================================================
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/api/auth
COOKIE_DOMAIN=

# =============================================================================
# Credentials encryption (AES-256-GCM) — min 32 characters
# =============================================================================
CREDENTIALS_ENCRYPTION_KEY=change-me-credentials-encryption-key-32b

# =============================================================================
# Phase 12 — Production readiness / ops
# =============================================================================
APP_VERSION=0.1.0
DOMAIN=localhost
TRUST_PROXY=false
SWAGGER_ENABLED=true
ROLLOUT_STAGE=A
PROCESS_ROLE=all
SCHEDULER_LOCK_TTL_SECONDS=55
WORKER_HEALTH_PORT=3101
WORKER_HEALTH_HOST=worker
WORKER_SHUTDOWN_TIMEOUT_MS=90000
WORKER_MEMORY_LIMIT_MB=2048
WORKER_LOCK_DURATION_MS=120000
WORKER_STALLED_INTERVAL_MS=60000
WORKER_MAX_STALLED_COUNT=2
FFMPEG_THREADS=2
IMAGE_GENERATION_MAX_CONCURRENCY=2
PUBLISHING_MAX_CONCURRENCY=2
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=600
TEMP_CLEANUP_MAX_AGE_HOURS=24
TEMP_CLEANUP_DISABLED=false
DISK_USAGE_ALERT_PERCENT=85
MEMORY_ALERT_PERCENT=90
QUEUE_BACKLOG_ALERT_THRESHOLD=100
PROVIDER_SPEND_ALERT_USD=50
BACKUP_STALE_HOURS=36
ALERTS_ENABLED=true
ALERT_COOLDOWN_MINUTES=30
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_TOKEN=
REGISTRATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPT_PASSPHRASE=
BACKUP_INTERVAL_SECONDS=86400
REDIS_MAXMEMORY=512mb
MINIO_PUBLIC_URL=
OPS_MONITOR_DISABLED=false
TOKEN_MAINTENANCE_CRON_DISABLED=false
