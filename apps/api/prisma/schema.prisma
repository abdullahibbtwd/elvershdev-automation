/// Aggregated production + cross-platform performance for one completed render.
model VideoAnalytics {
  id                         String                   @id @default(uuid())
  userId                     String                   @map("user_id")
  storyId                    String                   @map("story_id")
  videoRenderId              String                   @unique @map("video_render_id")
  title                      String?
  category                   String?
  publishedAt                DateTime?                @map("published_at")
  renderDurationMs           Int?                     @map("render_duration_ms")
  videoDurationSeconds       Float?                   @map("video_duration_seconds")
  generationCostUsd          Decimal                  @default(0) @map("generation_cost_usd") @db.Decimal(12, 6)
  renderingCostUsd           Decimal                  @default(0) @map("rendering_cost_usd") @db.Decimal(12, 6)
  totalProductionCostUsd     Decimal                  @default(0) @map("total_production_cost_usd") @db.Decimal(12, 6)
  costIsEstimate             Boolean                  @default(true) @map("cost_is_estimate")
  platformsPublishedCount    Int                      @default(0) @map("platforms_published_count")
  /// Sum of available platform views only; platforms without views are excluded.
  aggregateViews             BigInt?                  @map("aggregate_views")
  aggregateLikes             BigInt?                  @map("aggregate_likes")
  aggregateComments          BigInt?                  @map("aggregate_comments")
  aggregateShares            BigInt?                  @map("aggregate_shares")
  aggregateEngagement        BigInt?                  @map("aggregate_engagement")
  /// Method used for aggregates, e.g. sum_available_platforms_only
  aggregationMethod          String                   @default("sum_available_platforms_only") @map("aggregation_method")
  platformsWithViewsCount    Int                      @default(0) @map("platforms_with_views_count")
  platformsWithEngagementCount Int                    @default(0) @map("platforms_with_engagement_count")
  performanceStatus          ContentPerformanceStatus @default(UNKNOWN) @map("performance_status")
  lastSyncedAt               DateTime?                @map("last_synced_at")
  costBreakdown              Json                     @default("{}") @map("cost_breakdown")
  metadata                   Json                     @default("{}")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoRender VideoRender @relation(fields: [videoRenderId], references: [id], onDelete: Cascade)
  platformPosts PlatformPostAnalytics[]

  @@index([userId])
  @@index([storyId])
  @@index([publishedAt])
  @@index([category])
  @@index([userId, publishedAt])
  @@index([performanceStatus])
  @@map("video_analytics")
}

