# Copy to .env.production and replace every placeholder before deploy.
# scripts/deploy.sh refuses insecure defaults.

NODE_ENV=production
APP_VERSION=0.1.0
DOMAIN=example.com
HTTP_PORT=80
HTTPS_PORT=443

PORT=3000
API_PREFIX=api
CORS_ORIGIN=https://example.com
PUBLIC_API_URL=https://example.com
SOCIAL_FRONTEND_REDIRECT_URL=https://example.com
VITE_API_URL=/api
TRUST_PROXY=true
SWAGGER_ENABLED=false
LOG_LEVEL=info
ROLLOUT_STAGE=A
# Compose sets PROCESS_ROLE=api on api and PROCESS_ROLE=scheduler on api-scheduler.
# Coolify: do NOT put PROCESS_ROLE in shared env (one value would hit every service).
# Leave Compose as the source of truth. Do not set PROCESS_ROLE=all in multi-container prod.
# Public registration is removed. Existing users login only; create new accounts via DB/seed.
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_32+_CHAR_BOOTSTRAP_TOKEN
QUEUE_BACKLOG_ALERT_THRESHOLD=100
PROVIDER_SPEND_ALERT_USD=50
BACKUP_STALE_HOURS=36

POSTGRES_USER=aivideo
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=aivideo
DATABASE_URL=postgresql://aivideo:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/aivideo?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=REPLACE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_MINIO_SECRET_KEY_MIN_16_CHARS
MINIO_BUCKET=ai-video
MINIO_REGION=us-east-1
# Optional on Coolify: leave empty to serve media via API HMAC URLs
# (GET /api/media/content). Set these only when you also route /media-proxy → MinIO.
MINIO_PUBLIC_URL=
SOCIAL_PUBLIC_MEDIA_BASE_URL=

SOCIAL_PRESIGN_TTL_SECONDS=7200

JWT_ACCESS_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_32+_CHAR_ENCRYPTION_KEY

COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_PATH=/api/auth
COOKIE_DOMAIN=example.com

WORKER_CONCURRENCY=2
VIDEO_RENDER_MAX_CONCURRENCY=1
IMAGE_GENERATION_MAX_CONCURRENCY=2
PUBLISHING_MAX_CONCURRENCY=2
KLING_MAX_CONCURRENCY=2
GEMINI_TTS_MAX_CONCURRENCY=2
FFMPEG_THREADS=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_RENDER_MAX_OUTPUT_BYTES=524288000
WORKER_HEALTH_PORT=3101
WORKER_HEALTH_HOST=worker
WORKER_MEMORY_LIMIT_MB=2048
WORKER_SHUTDOWN_TIMEOUT_MS=90000
SCHEDULER_LOCK_TTL_SECONDS=55
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=600
TEMP_CLEANUP_MAX_AGE_HOURS=24
MEDIA_INTERMEDIATE_RETENTION_HOURS=24
MEDIA_FINAL_RETENTION_DAYS=7
MEDIA_RETENTION_DISABLED=false
DISK_USAGE_ALERT_PERCENT=85
MEMORY_ALERT_PERCENT=90

API_MEMORY_LIMIT=768M
API_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=2G
WORKER_CPU_LIMIT=1.0

ALERTS_ENABLED=true
ALERT_COOLDOWN_MINUTES=30
ADMIN_EMAIL=ops@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPT_PASSPHRASE=
BACKUP_INTERVAL_SECONDS=86400

# Provider keys — keep mocks true until Stage C
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Series movie planning (characters/arc) often exceeds 60s — use 180s+.
GEMINI_TIMEOUT_MS=180000
GEMINI_MAX_RETRIES=3
GEMINI_USE_MOCK=true
FAL_API_KEY=
FAL_USE_MOCK=true
VIDEO_GENERATION_PROVIDER=hailuo
HAILUO_ENABLED=true
HAILUO_MODEL=fal-ai/minimax/hailuo-02/standard/image-to-video
HAILUO_DEFAULT_RESOLUTION=768P
HAILUO_DEFAULT_DURATION=6
HAILUO_PROMPT_OPTIMIZER=true
HAILUO_MAX_RETRIES=2
HAILUO_TIMEOUT_MS=600000
HAILUO_USE_MOCK=true
HAILUO_PRICE_PER_SECOND_768P_USD=0.045
HAILUO_PRICE_PER_SECOND_512P_USD=0.017
HAILUO_MAX_MONTHLY_SPEND_USD=
KLING_ENABLED=false
KLING_API_KEY=
KLING_USE_MOCK=true
GEMINI_TTS_USE_MOCK=true
SOCIAL_USE_MOCK=true
# Series Studio: force dry-run publish (no social posts) even when SOCIAL_USE_MOCK=false
SERIES_PUBLISH_DRY_RUN=false
# Series Studio process gates (set true to disable without code changes)
SERIES_CRON_DISABLED=false
SERIES_QUEUE_HOST_DISABLED=false
# Keep episode production concurrency at 1 on resource-constrained VPS (also SeriesAutomationConfig.maxConcurrentEpisodeProduction)
# Autonomy is a DB setting (SeriesAutomationConfig.autonomyMode = MANUAL | FULLY_AUTONOMOUS), not an env var.
# Mock AI (GEMINI_USE_MOCK / SOCIAL_USE_MOCK) is independent of autonomyMode.
# New lanes default timezone: Africa/Lagos (set per lane in Series Settings).

FACEBOOK_USE_MOCK=true
INSTAGRAM_USE_MOCK=true
TIKTOK_USE_MOCK=true
YOUTUBE_USE_MOCK=true

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://example.com/api/channels/facebook/callback
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://example.com/api/channels/instagram/callback
INSTAGRAM_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://example.com/api/channels/tiktok/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://example.com/api/channels/youtube/callback
YOUTUBE_REFRESH_TOKEN=
