  channelId               String?                @map("channel_id")
  platform                SocialPlatform
  providerPostId          String?                @map("provider_post_id")
  postUrl                 String?                @map("post_url")
  publishedAt             DateTime?              @map("published_at")
  views                   BigInt?
  reach                   BigInt?
  impressions             BigInt?
  likes                   BigInt?
  comments                BigInt?
  shares                  BigInt?
  saves                   BigInt?
  watchTimeSeconds        Float?                 @map("watch_time_seconds")
  averageWatchSeconds     Float?                 @map("average_watch_seconds")
  completionRate          Float?                 @map("completion_rate")
  engagementRate          Float?                 @map("engagement_rate")
  followersGained         Int?                   @map("followers_gained")
  /// Per-metric availability map: { views: { status, reason?, definition? }, ... }
  metricAvailability      Json                   @default("{}") @map("metric_availability")
  metricSource            AnalyticsMetricSource  @default(UNAVAILABLE) @map("metric_source")
  lastSuccessfulSyncAt    DateTime?              @map("last_successful_sync_at")
  lastSyncAttemptAt       DateTime?              @map("last_sync_attempt_at")
  lastSyncError           String?                @map("last_sync_error")
  syncFailCount           Int                    @default(0) @map("sync_fail_count")
  /// Truncated provider payload (size-capped in application code).
  rawProviderResponse     Json?                  @map("raw_provider_response")
  platformMetricNotes     Json                   @default("{}") @map("platform_metric_notes")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishRecord  PublishRecord   @relation(fields: [publishRecordId], references: [id], onDelete: Cascade)
  videoAnalytics VideoAnalytics? @relation(fields: [videoAnalyticsId], references: [id], onDelete: SetNull)
  channel        SocialChannel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([platform])
  @@index([videoRenderId])
  @@index([channelId])
  @@index([publishedAt])
  @@index([userId, platform, publishedAt])
  @@index([lastSuccessfulSyncAt])
  @@map("platform_post_analytics")
}

/// Point-in-time snapshot for a reporting window (deduped by unique key).
model AnalyticsSnapshot {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  /// day | week | month | custom
  windowType     String   @map("window_type")
  windowStart    DateTime @map("window_start")
  windowEnd      DateTime @map("window_end")
  /// Deterministic key: userId:windowType:startIso:endIso[:scope]
  snapshotKey    String   @unique @map("snapshot_key")
  scope          String   @default("overview")
  platform       SocialPlatform?
  metrics        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([windowStart, windowEnd])
  @@index([userId, windowType])
  @@map("analytics_snapshots")
}

/// Rolled-up performance by content dimension (category, theme, genre, format, duration_bucket).
model ContentPerformanceSummary {
  id                String                   @id @default(uuid())
  userId            String                   @map("user_id")
  dimension         String
  dimensionValue    String                   @map("dimension_value")
  platform          SocialPlatform?
  sampleSize        Int                      @default(0) @map("sample_size")
  dateFrom          DateTime                 @map("date_from")
  dateTo            DateTime                 @map("date_to")
  avgViews          Float?                   @map("avg_views")
  avgEngagement     Float?                   @map("avg_engagement")
  avgEngagementRate Float?                   @map("avg_engagement_rate")
  avgCompletionRate Float?                   @map("avg_completion_rate")
  avgCostUsd        Float?                   @map("avg_cost_usd")
  totalViews        BigInt?                  @map("total_views")
  performanceStatus ContentPerformanceStatus @default(UNKNOWN) @map("performance_status")
  supportingMetrics Json                     @default("{}") @map("supporting_metrics")
  summaryKey        String                   @unique @map("summary_key")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dimension, dimensionValue])
  @@index([userId, dimension])
  @@map("content_performance_summaries")
}

/// Cached cost rollup derived from ProviderUsage (never duplicates usage rows).
model CostBreakdown {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  /// day | month | video | provider | stage
  scopeType             String   @map("scope_type")
  scopeKey              String   @map("scope_key")
  storyId               String?  @map("story_id")
  videoRenderId         String?  @map("video_render_id")
  provider              String?
  stage                 String?
  periodStart           DateTime? @map("period_start")
  periodEnd             DateTime? @map("period_end")
  estimatedCostUsd      Decimal  @default(0) @map("estimated_cost_usd") @db.Decimal(12, 6)
  actualCostUsd         Decimal? @map("actual_cost_usd") @db.Decimal(12, 6)
  isEstimate            Boolean  @default(true) @map("is_estimate")
  usageRecordCount      Int      @default(0) @map("usage_record_count")
  failedRetryCostUsd    Decimal  @default(0) @map("failed_retry_cost_usd") @db.Decimal(12, 6)
  breakdown             Json     @default("{}")
  breakdownKey          String   @unique @map("breakdown_key")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scopeType])
  @@index([provider])
  @@index([storyId])
  @@index([videoRenderId])
  @@index([userId, scopeType, periodStart])
  @@map("cost_breakdowns")
}

model AnalyticsSyncJob {
  id                String                 @id @default(uuid())
  userId            String                 @map("user_id")
  jobType           AnalyticsSyncJobType   @map("job_type")
  status            AnalyticsSyncJobStatus @default(PENDING)
  platform          SocialPlatform?
  publishRecordId   String?                @map("publish_record_id")
  channelId         String?                @map("channel_id")
  videoRenderId     String?                @map("video_render_id")
  queueName         String?                @map("queue_name")
  queueJobId        String?                @map("queue_job_id")
  attemptCount      Int                    @default(0) @map("attempt_count")
  maxAttempts       Int                    @default(5) @map("max_attempts")
  progress          Int                    @default(0)
  postsTargeted     Int                    @default(0) @map("posts_targeted")
  postsSucceeded    Int                    @default(0) @map("posts_succeeded")
  postsFailed       Int                    @default(0) @map("posts_failed")
  postsSkipped      Int                    @default(0) @map("posts_skipped")
  lastError         String?                @map("last_error")
  platformResults   Json                   @default("{}") @map("platform_results")
  payload           Json                   @default("{}")
  startedAt         DateTime?              @map("started_at")
  completedAt       DateTime?              @map("completed_at")
  nextRetryAt       DateTime?              @map("next_retry_at")
  idempotencyKey    String?                @unique @map("idempotency_key")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([jobType])
  @@index([userId, status])
  @@index([nextRetryAt])
  @@map("analytics_sync_jobs")
}

model AnalyticsInsight {
  id                 String                     @id @default(uuid())
  userId             String                     @map("user_id")
  recommendation     String                     @db.Text
  supportingMetrics  Json                       @default("{}") @map("supporting_metrics")
  sampleSize         Int                        @map("sample_size")
  confidence         AnalyticsInsightConfidence
  platform           SocialPlatform?
  suggestedExperiment String                    @map("suggested_experiment") @db.Text
  dateFrom           DateTime                   @map("date_from")
  dateTo             DateTime                   @map("date_to")
  category           String?
  /// correlation_only | observational — never causation claims
  evidenceType       String                     @default("observational") @map("evidence_type")
  dismissedAt        DateTime?                  @map("dismissed_at")
  metadata           Json                       @default("{}")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([confidence])
  @@index([userId, createdAt])
  @@map("analytics_insights")
}

model AnalyticsOptimizationSettings {
  id                              String   @id @default(uuid())
  userId                          String   @unique @map("user_id")
  performanceOptimizationEnabled  Boolean  @default(false) @map("performance_optimization_enabled")
  minSampleSizeForOptimization    Int      @default(10) @map("min_sample_size_for_optimization")
  preferStrongCategories          Boolean  @default(true) @map("prefer_strong_categories")
  avoidWeakFormats                Boolean  @default(false) @map("avoid_weak_formats")
  suggestDurationAdjustments      Boolean  @default(true) @map("suggest_duration_adjustments")
  suggestCaptionExperiments       Boolean  @default(true) @map("suggest_caption_experiments")
  diversityFloorPercent           Int      @default(30) @map("diversity_floor_percent")
  insightLookbackDays             Int      @default(90) @map("insight_lookback_days")
  syncRecentHours                 Int      @default(6) @map("sync_recent_hours")
  syncOlderHours                  Int      @default(48) @map("sync_older_hours")
  recentPostMaxAgeDays            Int      @default(7) @map("recent_post_max_age_days")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics_optimization_settings")
}

enum SystemAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SystemAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum BackupStatus {
  PENDING
  SUCCESS
  FAILED
  VERIFIED
}

/// Deduplicated operational alerts for admins (Phase 12).
model SystemAlert {
  id              String              @id @default(uuid())
  dedupeKey       String              @unique @map("dedupe_key")
  type            String
  severity        SystemAlertSeverity @default(WARNING)
  status          SystemAlertStatus   @default(OPEN)
  title           String
  body            String              @db.Text
  metadata        Json                @default("{}")
  occurrenceCount Int                 @default(1) @map("occurrence_count")
  lastFiredAt     DateTime            @default(now()) @map("last_fired_at")
  cooldownUntil   DateTime?           @map("cooldown_until")
  resolvedAt      DateTime?           @map("resolved_at")
  emailSentAt     DateTime?           @map("email_sent_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([status, severity])
  @@index([type])
  @@index([lastFiredAt])
  @@map("system_alerts")
}

model BackupRecord {
  id           String       @id @default(uuid())
  type         String       @default("postgres")
  status       BackupStatus @default(PENDING)
  fileName     String?      @map("file_name")
  fileSizeBytes BigInt?     @map("file_size_bytes")
  checksum     String?
  destination  String?
  errorMessage String?      @map("error_message") @db.Text
  startedAt    DateTime     @default(now()) @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  verifiedAt   DateTime?    @map("verified_at")
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([startedAt])
  @@map("backup_records")
}

/// Persistent record of work interrupted by emergency stop (Phase 12.1).
/// Distinguishes local CANCELLED from external work that may still be running.
model InterruptedTask {
  id               String   @id @default(uuid())
  userId           String?  @map("user_id")
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  previousStatus   String   @map("previous_status")
  outcome          String
  /// cancelled | interrupt_signaled | provider_cancel_unsupported | provider_cancelled | ffmpeg_kill_signaled
  providerTaskId   String?  @map("provider_task_id")
  provider         String?
  queueName        String?  @map("queue_name")
  queueJobId       String?  @map("queue_job_id")
  reason           String
  metadata         Json     @default("{}")
  republishBlocked Boolean  @default(true) @map("republish_blocked")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([outcome])
  @@index([createdAt])
  @@index([republishBlocked])
  @@map("interrupted_tasks")
}
