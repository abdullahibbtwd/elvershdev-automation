FROM node:20-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
# Coolify injects ARG NODE_ENV=production into every stage; that makes pnpm
# skip typescript/vite and breaks the shared/web builds below.
# Force development for install even if Coolify later re-sets NODE_ENV via ARG.
ARG NODE_ENV=development
ENV NODE_ENV=development
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN NODE_ENV=development pnpm install --frozen-lockfile=false --prod=false

FROM deps AS build
ARG NODE_ENV=development
ENV NODE_ENV=development
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
COPY packages ./packages
COPY apps/web ./apps/web
RUN NODE_ENV=development pnpm --filter @ai-video/shared build
RUN NODE_ENV=development pnpm --filter @ai-video/web build

FROM nginx:1.27-alpine AS runner
RUN addgroup -g 1001 -S aivideo \
  && adduser -S -D -H -u 1001 -G aivideo aivideo \
  && mkdir -p /var/cache/nginx /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp \
  && chown -R aivideo:aivideo /var/cache/nginx /usr/share/nginx/html /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp

COPY infrastructure/docker/nginx.main.conf /etc/nginx/nginx.conf
COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
RUN chown -R aivideo:aivideo /usr/share/nginx/html

USER aivideo
EXPOSE 8080
# Skip the stock entrypoint (it tries to rewrite conf as root).
ENTRYPOINT []
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
