FROM node:20-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
# Coolify injects ARG NODE_ENV=production into every stage; that makes pnpm
# skip typescript/nest and breaks the shared/api builds below.
ARG NODE_ENV=development
ENV NODE_ENV=development
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN NODE_ENV=development pnpm install --frozen-lockfile=false --prod=false

FROM deps AS build
ARG NODE_ENV=development
ENV NODE_ENV=development
COPY packages ./packages
COPY apps/api ./apps/api
RUN NODE_ENV=development pnpm --filter @ai-video/shared build
WORKDIR /app/apps/api
RUN NODE_ENV=development pnpm exec prisma generate
RUN NODE_ENV=development pnpm build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
  && apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 aivideo \
  && useradd --system --uid 1001 --gid aivideo --create-home aivideo

COPY --from=build --chown=aivideo:aivideo /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build --chown=aivideo:aivideo /app/node_modules ./node_modules
COPY --from=build --chown=aivideo:aivideo /app/packages ./packages
COPY --from=build --chown=aivideo:aivideo /app/apps/api ./apps/api
COPY infrastructure/docker/api-entrypoint.sh /api-entrypoint.sh
RUN chmod 755 /api-entrypoint.sh && chown aivideo:aivideo /api-entrypoint.sh

USER aivideo
WORKDIR /app/apps/api
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=8 \
  CMD curl -fsS http://127.0.0.1:3000/api/health/live || exit 1
# Invoke via sh so a missing +x bit never silently kills the container.
ENTRYPOINT ["sh", "/api-entrypoint.sh"]
