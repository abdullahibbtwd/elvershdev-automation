generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum StoryStatus {
  DRAFT
  GENERATING
  READY
  FAILED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  RENDERING
  READY
  FAILED
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  SUBTITLE
  OTHER
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum GenerationJobType {
  STORY
  SCENE_PLANNING
  VISUAL_ANALYSIS
  CHARACTER_REFERENCE
  IMAGE
  MOTION_ANALYSIS
  VIDEO
  NARRATION_PLANNING
  VOICE
  RENDER
  PUBLISH
  ANALYTICS
}

enum NarrationScriptStatus {
  DRAFT
  PLANNING
  READY
  APPROVED
  FAILED
}

enum SceneNarrationStatus {
  DRAFT
  READY
  APPROVED
  FAILED
}

enum AudioGenerationStatus {
  PENDING
  GENERATING
  VALIDATING
  STORING
  COMPLETED
  FAILED
  CANCELLED
}

enum VisualGenerationStatus {
  PENDING
  ANALYZING
  PROMPT_READY
  GENERATING
  COMPLETED
  FAILED
}

enum MotionGenerationStatus {
  PENDING
  ANALYZING
  SUBMITTING
  PROCESSING
  DOWNLOADING
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

enum VideoRenderStatus {
  PENDING
  PLANNING
  PREPARING_ASSETS
  RENDERING_SCENES
  MIXING_AUDIO
  GENERATING_SUBTITLES
  COMBINING
  VALIDATING
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

enum VideoRenderSceneStatus {
  PENDING
  READY
  RENDERING
  COMPLETED
  FAILED
  SKIPPED
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

enum PublishStatus {
  DRAFT
  QUEUED
  VALIDATING
  UPLOADING
  PROCESSING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  ACTION_REQUIRED
  SCHEDULED
  INTERRUPTED
}

enum SocialConnectionStatus {
  CONNECTED
  MISSING_PERMISSIONS
  NOT_ELIGIBLE
  TEST_ONLY
  PUBLIC_READY
  EXPIRED
  REVOKED
  ERROR
  DISCONNECTED
}

enum StoryGenerationType {
  STORY
  SCENES
  REGENERATE
}

enum AutomationRunMode {
  ENABLED
  PAUSED
  EMERGENCY_STOP
}

enum ContentPlanStatus {
  DRAFT
  APPROVED
  GENERATING
  GENERATED
  FAILED
  CANCELLED
  SKIPPED
}

enum ContentScheduleStatus {
  PLANNED
  QUEUED
  GENERATING
  RENDERING
  READY
  SCHEDULING_PUBLISH
  PUBLISHING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
  BUDGET_BLOCKED
  SKIPPED
}

enum AutomationStage {
  PLANNING
  STORY_GENERATION
  SCENE_PLANNING
  VISUAL_INTELLIGENCE
  MOTION_GENERATION
  NARRATION
  SPEECH
  RENDER
  PUBLISH_SCHEDULE
  DONE
}

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
  BUDGET_BLOCKED
  STALLED
}

enum ScheduledPublicationStatus {
  PENDING
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  SKIPPED
  BUDGET_BLOCKED
  INELIGIBLE
}

enum MetricAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  NOT_SYNCED
  SYNC_FAILED
  ESTIMATED
}

enum AnalyticsMetricSource {
  PROVIDER_API
  MOCK
  ESTIMATED
  DERIVED
  UNAVAILABLE
}

enum AnalyticsSyncJobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AnalyticsSyncJobType {
  FULL
  MANUAL
  INITIAL_POST
  POST_REFRESH
  ACCOUNT_REFRESH
  AGGREGATION
  INSIGHTS
}

enum AnalyticsInsightConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ContentPerformanceStatus {
  UNKNOWN
  UNDERPERFORMING
  AVERAGE
  STRONG
  TOP
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(EDITOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshSessions        RefreshSession[]
  socialChannels         SocialChannel[]
  stories                Story[]
  videoProjects          VideoProject[]
  mediaAssets            MediaAsset[]
  generationJobs         GenerationJob[]
  publishRecords         PublishRecord[]
  storyGenerations       StoryGeneration[]
  providerUsages         ProviderUsage[]
  visualStyles           VisualStyle[]
  motionGenerations      MotionGeneration[]
  narrationScripts       NarrationScript[]
  voiceProfiles          VoiceProfile[]
  audioGenerations       AudioGeneration[]
  videoRenders           VideoRender[]
  oauthStates            OAuthState[]
  automationConfig       AutomationConfig?
  contentPlans           ContentPlan[]
  contentSchedules       ContentSchedule[]
  scheduledPublications  ScheduledPublication[]
  automationExecutions   AutomationExecution[]
  notifications               Notification[]
  automationAuditLogs         AutomationAuditLog[]
  videoAnalytics              VideoAnalytics[]
  platformPostAnalytics       PlatformPostAnalytics[]
  analyticsSnapshots          AnalyticsSnapshot[]
  contentPerformanceSummaries ContentPerformanceSummary[]
  costBreakdowns              CostBreakdown[]
  analyticsSyncJobs           AnalyticsSyncJob[]
  analyticsInsights           AnalyticsInsight[]
  analyticsOptimizationSettings AnalyticsOptimizationSettings?

  @@index([email])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model SocialChannel {
  id                    String                 @id @default(uuid())
  userId                String                 @map("user_id")
  platform              SocialPlatform
  accountName           String                 @map("account_name")
  username              String?
  platformAccountId     String                 @map("platform_account_id")
  profileImageUrl       String?                @map("profile_image_url")
  accountType           String?                @map("account_type")
  connectionStatus      SocialConnectionStatus @default(CONNECTED) @map("connection_status")
  grantedScopes         String[]               @default([]) @map("granted_scopes")
  publishingCapabilities Json                  @default("{}") @map("publishing_capabilities")
  accessTokenEncrypted  String                 @map("access_token_encrypted")
  refreshTokenEncrypted String?                @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?              @map("token_expires_at")
  lastConnectionCheckAt DateTime?              @map("last_connection_check_at")
  lastError             String?                @map("last_error")
  metadata              Json                   @default("{}")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishRecords        PublishRecord[]
  platformPostAnalytics PlatformPostAnalytics[]

  @@unique([userId, platform, platformAccountId])
  @@index([userId])
  @@index([platform])
  @@index([connectionStatus])
  @@map("social_channels")
}

model OAuthState {
  id           String         @id @default(uuid())
  state        String         @unique
  userId       String         @map("user_id")
  provider     SocialPlatform
  codeVerifier String?        @map("code_verifier")
  redirectPath String?        @map("redirect_path")
  metadata     Json           @default("{}")
  expiresAt    DateTime       @map("expires_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_states")
}

model Story {
  id                     String      @id @default(uuid())
  userId                 String      @map("user_id")
  title                  String
  content                String      @db.Text
  status                 StoryStatus @default(DRAFT)
  topic                  String?
  niche                  String?
  targetAudience         String?     @map("target_audience")
  language               String      @default("en")
  tone                   String?
  category               String?
  targetDurationSeconds  Int?        @map("target_duration_seconds")
  openingHook            String?     @map("opening_hook") @db.Text
  narrationScript        String?     @map("narration_script") @db.Text
  closingMessage         String?     @map("closing_message") @db.Text
  description            String?     @db.Text
  hashtags               String[]    @default([])
  visualStyleId          String?     @map("visual_style_id")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  visualStyle      VisualStyle?      @relation(fields: [visualStyleId], references: [id], onDelete: SetNull)
  videoProjects    VideoProject[]
  generations      StoryGeneration[]
  scenes           StoryScene[]
  characters       CharacterProfile[]
  generationJobs    GenerationJob[]
  providerUsages    ProviderUsage[]
  motionGenerations MotionGeneration[]
  narrationScripts  NarrationScript[]
  audioGenerations  AudioGeneration[]
  videoRenders      VideoRender[]

  @@index([userId])
  @@index([status])
  @@index([visualStyleId])
  @@map("stories")
}

model StoryGeneration {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  storyId         String              @map("story_id")
  generationJobId String?             @unique @map("generation_job_id")
  requestType     StoryGenerationType @map("request_type")
  status          JobStatus           @default(PENDING)
  promptParams    Json                @map("prompt_params")
  model           String?
  inputTokens     Int?                @map("input_tokens")
  outputTokens    Int?                @map("output_tokens")
  estimatedCost   Decimal?            @map("estimated_cost") @db.Decimal(12, 6)
  errorMessage    String?             @map("error_message")
  result          Json?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  story         Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storyId])
  @@index([status])
  @@map("story_generations")
}

model StoryScene {
  id                               String   @id @default(uuid())
  storyId                          String   @map("story_id")
  sceneNumber                      Int      @map("scene_number")
  durationSeconds                  Float    @map("duration_seconds")
  narration                        String   @db.Text
  visualDescription                String   @map("visual_description") @db.Text
  imagePrompt                      String   @map("image_prompt") @db.Text
  videoPrompt                      String   @map("video_prompt") @db.Text
  cameraMovement                   String   @map("camera_movement")
  lighting                         String
  environment                      String   @db.Text
  characterConsistencyInstructions String   @map("character_consistency_instructions") @db.Text
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  story             Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  visuals           SceneVisual[]
  motionGenerations MotionGeneration[]
  sceneNarrations   SceneNarration[]
  audioGenerations  AudioGeneration[]
  videoRenderScenes VideoRenderScene[]

  @@unique([storyId, sceneNumber])
  @@index([storyId])
  @@map("story_scenes")
}

model CharacterProfile {
  id                             String   @id @default(uuid())
  storyId                        String   @map("story_id")
  name                           String
  appearance                     String   @db.Text
  clothing                       String   @db.Text
  ageRange                       String   @map("age_range")
  hair                           String
  distinctiveFeatures            String   @map("distinctive_features") @db.Text
  consistencyNotes               String   @map("consistency_notes") @db.Text
  genderPresentation             String?  @map("gender_presentation")
  skinTone                       String?  @map("skin_tone")
  facialFeatures                 String?  @map("facial_features") @db.Text
  hairstyle                      String?
  hairColor                      String?  @map("hair_color")
  bodyBuild                      String?  @map("body_build")
  accessories                    String?  @db.Text
  canonicalVisualDescription     String?  @map("canonical_visual_description") @db.Text
  visualConsistencyInstructions  String?  @map("visual_consistency_instructions") @db.Text
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  story             Story                      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  visualReferences  CharacterVisualReference[]

  @@unique([storyId, name])
  @@index([storyId])
  @@map("character_profiles")
}

model VisualStyle {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  name          String
  description   String   @db.Text
  configuration Json
  isDefault     Boolean  @default(false) @map("is_default")
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories      Story[]
  sceneVisuals SceneVisual[]

  @@unique([userId, name])
  @@index([userId])
  @@index([isDefault])
  @@map("visual_styles")
}

model SceneVisual {
  id                     String                 @id @default(uuid())
  sceneId                String                 @map("scene_id")
  visualStyleId          String?                @map("visual_style_id")
  visualPrompt           String                 @map("visual_prompt") @db.Text
  negativePrompt         String?                @map("negative_prompt") @db.Text
  structuredBrief        Json?                  @map("structured_brief")
  generationStatus       VisualGenerationStatus @default(PENDING) @map("generation_status")
  generatedImageMediaId  String?                @unique @map("generated_image_media_id")
  isSelected             Boolean                @default(false) @map("is_selected")
  attemptNumber          Int                    @default(1) @map("attempt_number")
  provider               String?
  providerModel          String?                @map("provider_model")
  generationParameters   Json?                  @map("generation_parameters")
  generationJobId        String?                @map("generation_job_id")
  seed                   Int?
  errorMessage           String?                @map("error_message")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  scene               StoryScene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  visualStyle         VisualStyle?       @relation(fields: [visualStyleId], references: [id], onDelete: SetNull)
  generatedImageMedia MediaAsset?        @relation("SceneVisualImage", fields: [generatedImageMediaId], references: [id], onDelete: SetNull)
  generationJob       GenerationJob?     @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  motionGenerations   MotionGeneration[]

  @@index([sceneId])
  @@index([generationStatus])
  @@index([generationJobId])
  @@index([sceneId, isSelected])
  @@map("scene_visuals")
}

model MotionGeneration {
  id                   String                 @id @default(uuid())
  userId               String                 @map("user_id")
  storyId              String                 @map("story_id")
  sceneId              String                 @map("scene_id")
  sourceVisualId       String                 @map("source_visual_id")
  sourceMediaAssetId   String                 @map("source_media_asset_id")
  provider             String                 @default("kling")
  providerModel        String?                @map("provider_model")
  providerTaskId       String?                @map("provider_task_id")
  motionPrompt         String                 @map("motion_prompt") @db.Text
  negativePrompt       String?                @map("negative_prompt") @db.Text
  structuredBrief      Json?                  @map("structured_brief")
  generationParameters Json?                  @map("generation_parameters")
  status               MotionGenerationStatus @default(PENDING)
  progress             Int                    @default(0)
  outputMediaAssetId   String?                @unique @map("output_media_asset_id")
  durationSeconds      Int                    @default(5) @map("duration_seconds")
  resolution           String                 @default("720p")
  estimatedCost        Decimal?               @map("estimated_cost") @db.Decimal(12, 6)
  actualCost           Decimal?               @map("actual_cost") @db.Decimal(12, 6)
  currency             String                 @default("USD")
  isSelected           Boolean                @default(false) @map("is_selected")
  attemptNumber        Int                    @default(1) @map("attempt_number")
  generationJobId      String?                @map("generation_job_id")
  pollAttempt          Int                    @default(0) @map("poll_attempt")
  errorCode            String?                @map("error_code")
  errorMessage         String?                @map("error_message")
  submittedAt          DateTime?              @map("submitted_at")
  completedAt          DateTime?              @map("completed_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  story            Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  scene            StoryScene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sourceVisual     SceneVisual    @relation(fields: [sourceVisualId], references: [id], onDelete: Cascade)
  sourceMediaAsset MediaAsset     @relation("MotionSourceMedia", fields: [sourceMediaAssetId], references: [id], onDelete: Restrict)
  outputMediaAsset MediaAsset?    @relation("MotionOutputMedia", fields: [outputMediaAssetId], references: [id], onDelete: SetNull)
  generationJob    GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storyId])
  @@index([sceneId])
  @@index([sourceVisualId])
  @@index([status])
  @@index([providerTaskId])
  @@index([generationJobId])
  @@index([sceneId, isSelected])
  @@index([storyId, status])
  @@map("motion_generations")
}

model CharacterVisualReference {
  id                 String   @id @default(uuid())
  characterProfileId String   @map("character_profile_id")
  mediaAssetId       String   @map("media_asset_id")
  prompt             String   @db.Text
  isPrimary          Boolean  @default(false) @map("is_primary")
  generationJobId    String?  @map("generation_job_id")
  createdAt          DateTime @default(now()) @map("created_at")

  characterProfile CharacterProfile @relation(fields: [characterProfileId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  generationJob    GenerationJob?   @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([characterProfileId])
  @@index([mediaAssetId])
  @@index([characterProfileId, isPrimary])
  @@map("character_visual_references")
}

model ProviderUsage {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  storyId         String?  @map("story_id")
  generationJobId String?  @map("generation_job_id")
  provider        String
  model           String
  requestType     String   @map("request_type")
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  estimatedCost   Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  story         Story?         @relation(fields: [storyId], references: [id], onDelete: SetNull)
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storyId])
  @@index([provider, model])
  @@map("provider_usages")
}

model VideoProject {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  storyId         String?          @map("story_id")
  title           String
  description     String?          @db.Text
  status          ProjectStatus    @default(DRAFT)
  duration        Int?
  aspectRatio     String?          @map("aspect_ratio")
  targetPlatforms SocialPlatform[] @map("target_platforms")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  story          Story?          @relation(fields: [storyId], references: [id], onDelete: SetNull)
  mediaAssets    MediaAsset[]
  generationJobs GenerationJob[]
  publishRecords PublishRecord[]

  @@index([userId])
  @@index([storyId])
  @@index([status])
  @@map("video_projects")
}

model MediaAsset {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  videoProjectId String?   @map("video_project_id")
  type           MediaType
  storageKey     String    @map("storage_key")
  originalName   String?   @map("original_name")
  mimeType       String?   @map("mime_type")
  fileSize       BigInt?   @map("file_size")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoProject              VideoProject?              @relation(fields: [videoProjectId], references: [id], onDelete: SetNull)
  sceneVisual               SceneVisual?               @relation("SceneVisualImage")
  characterVisualReferences CharacterVisualReference[]
  motionSourceFor           MotionGeneration[]         @relation("MotionSourceMedia")
  motionOutputFor           MotionGeneration?          @relation("MotionOutputMedia")
  audioGenerations          AudioGeneration[]          @relation("AudioMediaAsset")
  videoRenderOutputs        VideoRender[]              @relation("VideoRenderOutput")
  videoRenderSubtitles      VideoRender[]              @relation("VideoRenderSubtitle")
  videoRenderMusic          VideoRender[]              @relation("VideoRenderMusic")

  @@index([userId])
  @@index([videoProjectId])
  @@index([type])
  @@map("media_assets")
}

model GenerationJob {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  videoProjectId String?           @map("video_project_id")
  storyId        String?           @map("story_id")
  jobType        GenerationJobType @map("job_type")
  status         JobStatus         @default(PENDING)
  progress       Int               @default(0)
  provider       String?
  queueName      String?           @map("queue_name")
  queueJobId     String?           @map("queue_job_id")
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3) @map("max_attempts")
  estimatedCost  Decimal?          @map("estimated_cost") @db.Decimal(12, 4)
  actualCost     Decimal?          @map("actual_cost") @db.Decimal(12, 4)
  payload        Json?
  result         Json?
  errorMessage   String?           @map("error_message")
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoProject              VideoProject?              @relation(fields: [videoProjectId], references: [id], onDelete: SetNull)
  story                     Story?                     @relation(fields: [storyId], references: [id], onDelete: SetNull)
  storyGeneration           StoryGeneration?
  providerUsages            ProviderUsage[]
  sceneVisuals              SceneVisual[]
  characterVisualReferences CharacterVisualReference[]
  motionGenerations         MotionGeneration[]
  narrationScripts          NarrationScript[]
  audioGenerations          AudioGeneration[]
  videoRenders              VideoRender[]
  publishRecords            PublishRecord[]

  @@index([userId])
  @@index([videoProjectId])
  @@index([storyId])
  @@index([jobType, status])
  @@index([queueJobId])
  @@map("generation_jobs")
}

model PublishRecord {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  videoProjectId    String?        @map("video_project_id")
  videoRenderId     String?        @map("video_render_id")
  channelId         String?        @map("channel_id")
  platform          SocialPlatform
  status            PublishStatus  @default(DRAFT)
  caption           String?        @db.Text
  description       String?        @db.Text
  title             String?
  hashtags          String[]       @default([])
  platformSettings  Json           @default("{}") @map("platform_settings")
  providerUploadId  String?        @map("provider_upload_id")
  providerPublishId String?        @map("provider_publish_id")
  providerPostId    String?        @map("provider_post_id")
