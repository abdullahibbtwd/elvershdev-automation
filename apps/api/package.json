    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "social:verify": "ts-node -r tsconfig-paths/register scripts/verify-social-connectivity.ts",
    "social:bootstrap-meta": "ts-node -r tsconfig-paths/register scripts/bootstrap-meta-env-channels.ts"
  },
  "dependencies": {
